{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "description": "Schema ejemplo1",
    "type": "object",
    "properties": {
        "modelo": {
            "type": "object",
            "properties": {
                "metadatos": {
                    "type": "object",
                    "properties": {
                        "version": {
                            "type": "string",
                            "maxLength": 20
                        },
                        "autor": {
                            "type": "string",
                            "maxLength": 50
                        },
                        "fecha_creacion": {
                            "type": "string",
                            "format": "date"
                        },
                        "devices": {
                            "type": "array",
                            "items": {
                                "type": "string",
                                "maxLength": 20
                            },
                            "minItems": 1,
                            "maxItems": 5
                        },
                        "active": {
                            "type": "boolean",
                            "enum": [true, false]
                        }
                    },
                    "required": ["version", "devices", "active"]
                }
            },
            "required": ["metadatos"]
        }
    },
    "required": ["modelo"]
}